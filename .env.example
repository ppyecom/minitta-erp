# --- Node portable (solo si node no está en el PATH) -------------------------
NODE_BIN=

# --- Postgres: la base del ERP v2 -------------------------------------------
# PG_BIN / PG_DATA: solo si se usa el Postgres portable (scripts/pg.ps1)
PG_BIN=
PG_DATA=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=minitta_erp

# --- API / web ---------------------------------------------------------------
API_PORT=3000
# carpeta de imágenes locales, relativa a la raíz del repo
UPLOADS_DIR=uploads

# --- SQL Server: el ERP viejo, SOLO LECTURA ----------------------------------
# Lo usa db/migration/021_export_from_sqlserver.js para exportar el legacy.
# Pedir un usuario de consulta; este proyecto nunca escribe en el ERP viejo.
ERP_SQL_SERVER=
ERP_SQL_PORT=1433
ERP_SQL_DATABASE=
ERP_SQL_USER=
ERP_SQL_PASSWORD=
